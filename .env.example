# copy to .env for `just dev` / `just migrate` (gitignored)
NOTELET_DATABASE_URL=postgres://user:password@host:5432/notelet_dev
NOTELET_TOKEN=change-me
NOTELET_BIND=127.0.0.1:8490
NOTELET_ACTOR=dev
# for `just test-pg` (a throwaway database; the test writes under _test/)
NOTELET_TEST_DATABASE_URL=postgres://user:password@host:5432/notelet_test

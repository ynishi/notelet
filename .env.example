# copy to .env for `just dev` / `just migrate` (gitignored)
NOTELET_DATABASE_URL=postgres://user:password@host:5432/notelet_dev
NOTELET_TOKEN=change-me
NOTELET_BIND=127.0.0.1:8490
NOTELET_ACTOR=dev
# `just test-pg` defaults to the throwaway container from `just pg-up` (or `just test-pg-local`).
# Do not set NOTELET_TEST_DATABASE_URL to the dev database; the recipe refuses an identical value.
# A NOTELET_TEST_DATABASE_URL line copied from an older template should be removed.
